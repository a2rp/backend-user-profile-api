@baseUrl = http://localhost:1198

### Home
GET {{baseUrl}}/

### Health
GET {{baseUrl}}/health

### Register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "name": "Ashish",
  "email": "ashish@example.com",
  "password": "password123"
}

### Login
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "ashish@example.com",
  "password": "password123"
}

### Get profile
GET {{baseUrl}}/api/profile

### Update profile
PUT {{baseUrl}}/api/profile/update
Content-Type: application/json

{
  "name": "Ashish Ranjan",
  "bio": "Full-Stack Web Developer",
  "phone": "+91 9876543210"
}

### Change password
PUT {{baseUrl}}/api/profile/change-password
Content-Type: application/json

{
  "currentPassword": "password123",
  "newPassword": "new-password123"
}

### Update settings
PUT {{baseUrl}}/api/profile/settings
Content-Type: application/json

{
  "bio": "Backend and web development",
  "phone": "+91 9876543210"
}

### Logout
POST {{baseUrl}}/api/auth/logout
